@inherits LayoutComponentBase

<HeadContent>
    <link rel="stylesheet" href="@Assets["assets/lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["assets/app.css"]" />
    <script src="@Assets["assets/lib/bootstrap/dist/js/bootstrap.js"]"></script>
</HeadContent>

<div class="page d-flex justify-content-center">
    <ErrorBoundary>
        <ChildContent>
            <div class="fixed-top">
            </div>
            <article class="content">
                @Body
            </article>
        </ChildContent>
        <ErrorContent>
            <p class="text-danger">システムエラーが発生</p>
            <p>@context.Message</p>
        </ErrorContent>
    </ErrorBoundary>
</div>
