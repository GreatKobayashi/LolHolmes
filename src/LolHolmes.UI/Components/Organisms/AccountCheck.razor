@using LolHolmes.Domain.Entities
@inject HomeViewModel _homeViewModel;

<NameInput @ref="_nameInput" />
<Button Class="btn-primary" OnClick="LoadAccountEntity">アカウントチェック</Button>

@if (_homeViewModel.Account != null)
{
    <Account Value="_homeViewModel.Account" />
}

@code {
    [Parameter]
    public bool IsConfirmed { get; set; }

    private NameInput? _nameInput;

    private async Task LoadAccountEntity()
    {
        var inputs = _nameInput?.GetInputs() ?? ("", "");
        await _homeViewModel.LoadAccount(inputs.Item1, inputs.Item2);
    }
}
