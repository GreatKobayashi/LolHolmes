@inject IJSRuntime JSRuntime

<script src="@Assets["assets/js/modalHelper.js"]"></script>

<div class="modal fade" @key="@_id" id="@_id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Modal title</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Understood</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private static int _modals = 0;

    private string _id = "";
    private bool _isVisible;
    private bool _isJSLoaded;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await ShowModal();
        }
        else
        {
            await HideModal();
        }
    }

    protected override void OnInitialized()
    {
        _id = $"modalDialog{++_modals}";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isJSLoaded = true;
        }
    }

    private async Task ShowModal()
    {
        if (_isJSLoaded)
        {
            await JSRuntime.InvokeVoidAsync("showModal", _id);
        }
    }

    private async Task HideModal()
    {
        if (_isJSLoaded)
        {
            await JSRuntime.InvokeVoidAsync("hideModal", _id);
        }
    }
}
